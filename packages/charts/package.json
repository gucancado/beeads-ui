{
  "name": "@beeads/charts",
  "version": "0.1.1",
  "description": "Visualização de dados do design system beeads — wrappers sobre recharts com tokens unificados",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gucancado/beeads-ui",
    "directory": "packages/charts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-assets.mjs charts styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@beeads/tokens": "workspace:*",
    "@beeads/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "recharts": "^2.15.4",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
