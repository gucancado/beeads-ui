{
  "name": "@beeads/tokens",
  "version": "0.4.0",
  "description": "Design tokens (CSS vars) do design system beeads — suporta Tailwind v3 e v4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gucancado/beeads-ui",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./preset.cjs": "./dist/preset.cjs",
    "./vars.css": "./dist/vars.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node ../../scripts/copy-assets.mjs tokens theme.css preset.cjs vars.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
